#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${KUJO_RUNTIME_BIN:-}" ]]; then
	echo "Set KUJO_RUNTIME_BIN to the Kujo runtime binary path." >&2
	exit 2
fi

if [[ "${1:-}" == "test" ]]; then
	if [[ "$#" != "1" ]]; then
		echo "Concord's test entrypoint accepts no extra arguments." >&2
		exit 2
	fi
	exec node "$(cd "$(dirname "$0")" && pwd)/scripts/verify-native.mjs"
fi

tmp_dir="$(mktemp -d)"
cleanup() {
	rm -rf "$tmp_dir"
}
trap cleanup EXIT

rsync -a --exclude='.git' --exclude='.dogfood/concord/loop/runs' --exclude='target' ./ "$tmp_dir/"

alt_ext="$(printf '%b' '\162\165\146\146')"
find "$tmp_dir" -type f -name '*.kujo' -print0 | while IFS= read -r -d '' kujo_file; do
	cp "$kujo_file" "${kujo_file%.kujo}.${alt_ext}"
done

cd "$tmp_dir"
"$KUJO_RUNTIME_BIN" "$@"
