# Concord — common utilities (arg parsing, string helpers)

export func is_truthy(value) {
	s := to_lower(to_string(value))
	if s == "1" { return 1 }
	if s == "true" { return 1 }
	return 0
}

# --- Argument parsing ---

export func parse_flag(argv, flag, default_val) {
	mut i := 0
	while i < len(argv) {
		if argv[i] == flag {
			if i + 1 < len(argv) {
				next := argv[i + 1]
				if is_truthy(starts_with(next, "-")) == 1 {
					return "true"
				}
				return next
			}
			return "true"
		}
		i = i + 1
	}
	return default_val
}

export func has_flag(argv, flag) {
	mut i := 0
	while i < len(argv) {
		if argv[i] == flag {
			return 1
		}
		i = i + 1
	}
	return 0
}

export func parse_subcommand(argv) {
	if len(argv) < 1 {
		return ""
	}
	first := argv[0]
	if is_truthy(starts_with(first, "-")) == 1 {
		return ""
	}
	return first
}

export func is_flag_token(value) {
	return is_truthy(starts_with(to_string(value), "-"))
}

export func shift_args(argv) {
	mut result := []
	mut i := 1
	while i < len(argv) {
		result = push(result, argv[i])
		i = i + 1
	}
	return result
}

# --- String helpers ---

export func trim_space(s) {
	return trim(s)
}

export func to_lowercase(s) {
	return to_lower(s)
}

# --- File helpers ---

export func read_file_safe(path) {
	if is_truthy(file_exists(path)) == 0 {
		return ""
	}
	return read_file(path)
}

export func file_has_extension(path, ext) {
	return is_truthy(ends_with(to_lower(path), to_lower(ext)))
}

export func concord_version() {
	return "1.0.0"
}

export func verification_exit_code(findings) {
	if len(findings) > 0 {
		return 3
	}
	return 0
}

export func scan_exit_code(findings) {
	if highest_severity(findings) == "high" {
		return 1
	}
	return 0
}

# --- Version helpers ---

export func extract_version_from_text(text) {
	# Try to find a version pattern like 1.0.0 or v1.0.0
	mut matches := regex_find_all(text, "v?([0-9]+\\.[0-9]+\\.[0-9]+)")
	if len(matches) > 0 {
		return matches[0]
	}
	return ""
}

# --- Severity helpers ---

export func severity_weight(sev) {
	if sev == "critical" { return 4 }
	if sev == "high" { return 3 }
	if sev == "medium" { return 2 }
	if sev == "low" { return 1 }
	return 0
}

export func highest_severity(findings) {
	mut max_weight := 0
	mut i := 0
	while i < len(findings) {
		f := findings[i]
		mut w := severity_weight(f["severity"])
		if w > max_weight {
			max_weight = w
		}
		i = i + 1
	}
	if max_weight >= 3 { return "high" }
	if max_weight == 2 { return "medium" }
	if max_weight == 1 { return "low" }
	return "none"
}
