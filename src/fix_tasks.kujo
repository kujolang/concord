# Concord — Fix task card generation

from src.common import severity_weight, concord_version

func append_lines(text, lines) {
	mut result := text
	mut i := 0
	while i < len(lines) {
		result = result + lines[i] + "\n"
		i = i + 1
	}
	return result
}

func severity_emoji(severity) {
	if severity == "critical" { return "🔴" }
	if severity == "high" { return "🟠" }
	if severity == "medium" { return "🟡" }
	return "🔵"
}

func field_row(label, value) {
	mut clean := replace(to_string(value), "|", "\\|")
	clean = replace(clean, "\n", "<br>")
	return "| **" + label + "** | " + clean + " |"
}

export func generate_fix_tasks(findings) {
	version := concord_version()
	mut report := ""
	report = append_lines(report, [
		"# Concord Fix Tasks",
		"",
		"**Concord v" + version + "**",
		"",
		"---",
		""
	])

	if len(findings) == 0 {
		report = append_lines(report, [
			"✅ No fix tasks needed. No drift findings detected."
		])
		return report
	}

	# Sort findings by severity (high to low)
	mut ordered := []
	mut remaining := []
	mut i := 0
	while i < len(findings) {
		remaining = push(remaining, findings[i])
		i = i + 1
	}

	# Simple insertion sort by severity weight
	mut j := 0
	while j < len(remaining) {
		f := remaining[j]
		mut inserted := 0
		mut k := 0
		while k < len(ordered) {
			if severity_weight(f["severity"]) > severity_weight(ordered[k]["severity"]) {
				# Insert before k
				mut new_ordered := []
				mut x := 0
				while x < k {
					new_ordered = push(new_ordered, ordered[x])
					x = x + 1
				}
				new_ordered = push(new_ordered, f)
				mut y := k
				while y < len(ordered) {
					new_ordered = push(new_ordered, ordered[y])
					y = y + 1
				}
				ordered = new_ordered
				inserted = 1
				break
			}
			k = k + 1
		}
		if inserted == 0 {
			ordered = push(ordered, f)
		}
		j = j + 1
	}

	report = append_lines(report, [
		"## Action Required",
		"",
		"The following tasks address drift detected by Concord. Review each task and apply fixes as appropriate.",
		""
	])

	mut task_num := 1
	mut idx := 0
	while idx < len(ordered) {
		f := ordered[idx]

		report = append_lines(report, [
			"### Task " + to_string(task_num) + ": " + severity_emoji(f["severity"]) + " " + f["title"],
			"",
			"| Field | Value |",
			"|-------|-------|",
			field_row("Finding ID", "`" + f["id"] + "`"),
			field_row("Severity", f["severity"]),
			field_row("Confidence", f["confidence"]),
			field_row("Category", f["category"]),
			field_row("Human Review", to_string(f["human_review_required"])),
			"",
			"**Problem:** " + f["summary"],
			"",
			"**Affected Files:**",
			"- `" + f["source_artifact"] + "`"
		])
		if f["target_artifact"] != "(none)" {
			if f["target_artifact"] != "(multiple)" {
				report = append_lines(report, [
					"- `" + f["target_artifact"] + "`"
				])
			}
		}
		report = append_lines(report, [
			"",
			"**Suggested Fix:** " + f["suggested_fix"],
			"",
			"**Validation:** Run `concord scan` after applying the fix to verify drift is resolved.",
			"",
			"---",
			""
		])

		task_num = task_num + 1
		idx = idx + 1
	}

	return report
}
