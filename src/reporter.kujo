# Concord — Report generation (Markdown and JSON)

from src.common import severity_weight, highest_severity, concord_version

func append_lines(text, lines) {
	mut result := text
	mut i := 0
	while i < len(lines) {
		result = result + lines[i] + "\n"
		i = i + 1
	}
	return result
}

func category_label(cat) {
	if cat == "cli-docs-alignment" { return "CLI ↔ Docs Alignment" }
	if cat == "spec-eval-alignment" { return "Spec ↔ Eval Alignment" }
	if cat == "manifest-docs-alignment" { return "Manifest ↔ Docs Alignment" }
	if cat == "version-consistency" { return "Version Consistency" }
	if cat == "example-validity" { return "Example Validity" }
	if cat == "source-of-truth" { return "Source of Truth" }
	return cat
}

func severity_emoji(severity) {
	if severity == "critical" { return "🔴" }
	if severity == "high" { return "🟠" }
	if severity == "medium" { return "🟡" }
	return "🔵"
}

func field_row(label, value) {
	return "| **" + label + "** | " + value + " |"
}

export func generate_markdown_report(dir_path, findings) {
	mut report := ""
	version := concord_version()
	report = append_lines(report, [
		"# Concord Drift Report",
		"",
		"**Concord v" + version + "** | **Directory:** `" + dir_path + "`",
		"",
		"---",
		""
	])

	# Summary
	mut critical_count := 0
	mut high_count := 0
	mut medium_count := 0
	mut low_count := 0

	mut i := 0
	while i < len(findings) {
		sev := findings[i]["severity"]
		if sev == "critical" { critical_count = critical_count + 1 }
		if sev == "high" { high_count = high_count + 1 }
		if sev == "medium" { medium_count = medium_count + 1 }
		if sev == "low" { low_count = low_count + 1 }
		i = i + 1
	}

	report = append_lines(report, [
		"## Summary",
		"",
		"| Severity | Count |",
		"|----------|-------|",
		"| Critical | " + to_string(critical_count) + " |",
		"| High     | " + to_string(high_count) + " |",
		"| Medium   | " + to_string(medium_count) + " |",
		"| Low      | " + to_string(low_count) + " |",
		"| **Total** | **" + to_string(len(findings)) + "** |",
		""
	])

	overall := highest_severity(findings)
	if overall == "none" {
		report = append_lines(report, [
			"**Result:** ✅ No significant drift detected.",
			""
		])
	} else {
		report = append_lines(report, [
			"**Result:** ⚠️ Drift detected (highest severity: **" + overall + "**)",
			""
		])
	}

	report = append_lines(report, [
		"---",
		""
	])

	# Findings
	if len(findings) == 0 {
		report = append_lines(report, [
			"## Findings",
			"",
			"No drift findings. All checked artifacts appear consistent.",
			""
		])
	} else {
		report = append_lines(report, [
			"## Findings",
			""
		])

		# Group by category
		mut categories := {}
		mut j := 0
		while j < len(findings) {
			cat := findings[j]["category"]
			if has_key(categories, cat) == 0 {
				categories[cat] = []
			}
			mut cat_list := categories[cat]
			cat_list = push(cat_list, findings[j])
			categories[cat] = cat_list
			j = j + 1
		}

		mut cat_keys := keys(categories)
		mut c := 0
		while c < len(cat_keys) {
			cat := cat_keys[c]
			mut cat_findings := categories[cat]

			# Category header
			report = append_lines(report, [
				"### " + category_label(cat),
				""
			])

			mut f := 0
			while f < len(cat_findings) {
				finding := cat_findings[f]

				report = append_lines(report, [
					"#### " + severity_emoji(finding["severity"]) + " " + finding["title"],
					"",
					"| Field | Value |",
					"|-------|-------|",
					field_row("ID", "`" + finding["id"] + "`"),
					field_row("Severity", finding["severity"]),
					field_row("Confidence", finding["confidence"]),
					field_row("Source", "`" + finding["source_artifact"] + "`"),
					field_row("Target", "`" + finding["target_artifact"] + "`"),
					field_row("Review Required", to_string(finding["human_review_required"])),
					"",
					"**Summary:** " + finding["summary"],
					"",
					"**Expected:** " + finding["expected"],
					"",
					"**Actual:** " + finding["actual"],
					"",
					"**Suggested Fix:** " + finding["suggested_fix"],
					"",
					"---",
					""
				])
				f = f + 1
			}
			c = c + 1
		}
	}

	# Footer
	report = append_lines(report, [
		"---",
		"",
		"*Report generated by Concord v" + version + ". Concord is an MVP dogfood tool for the Kujo ecosystem.*"
	])

	return report
}

export func generate_json_report(dir_path, findings) {
	version := concord_version()
	mut categorized := {}

	mut i := 0
	while i < len(findings) {
		f := findings[i]
		cat := f["category"]
		if has_key(categorized, cat) == 0 {
			categorized[cat] = []
		}
		mut cat_list := categorized[cat]
		cat_list = push(cat_list, f)
		categorized[cat] = cat_list
		i = i + 1
	}

	mut report := {
		"tool": "concord",
		"version": version,
		"directory": dir_path,
		"summary": {
			"total_findings": len(findings),
			"highest_severity": highest_severity(findings)
		},
		"findings": findings,
		"findings_by_category": categorized
	}

	return to_json_pretty(report)
}
