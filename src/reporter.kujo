# Concord — Report generation (Markdown and JSON)

from src.common import severity_weight, highest_severity, concord_version

export func generate_markdown_report(dir_path, findings) {
	mut report := ""
	version := concord_version()
	report = report + "# Concord Drift Report\n\n"
	report = report + "**Concord v" + version + "** | **Directory:** `" + dir_path + "`\n\n"
	report = report + "---\n\n"

	# Summary
	mut critical_count := 0
	mut high_count := 0
	mut medium_count := 0
	mut low_count := 0

	mut i := 0
	while i < len(findings) {
		sev := findings[i]["severity"]
		if sev == "critical" { critical_count = critical_count + 1 }
		if sev == "high" { high_count = high_count + 1 }
		if sev == "medium" { medium_count = medium_count + 1 }
		if sev == "low" { low_count = low_count + 1 }
		i = i + 1
	}

	report = report + "## Summary\n\n"
	report = report + "| Severity | Count |\n"
	report = report + "|----------|-------|\n"
	report = report + "| Critical | " + to_string(critical_count) + " |\n"
	report = report + "| High     | " + to_string(high_count) + " |\n"
	report = report + "| Medium   | " + to_string(medium_count) + " |\n"
	report = report + "| Low      | " + to_string(low_count) + " |\n"
	report = report + "| **Total** | **" + to_string(len(findings)) + "** |\n\n"

	overall := highest_severity(findings)
	if overall == "none" {
		report = report + "**Result:** ✅ No significant drift detected.\n\n"
	} else {
		report = report + "**Result:** ⚠️ Drift detected (highest severity: **" + overall + "**)\n\n"
	}

	report = report + "---\n\n"

	# Findings
	if len(findings) == 0 {
		report = report + "## Findings\n\n"
		report = report + "No drift findings. All checked artifacts appear consistent.\n\n"
	} else {
		report = report + "## Findings\n\n"

		# Group by category
		mut categories := {}
		mut j := 0
		while j < len(findings) {
			cat := findings[j]["category"]
			if has_key(categories, cat) == 0 {
				categories[cat] = []
			}
			mut cat_list := categories[cat]
			cat_list = push(cat_list, findings[j])
			categories[cat] = cat_list
			j = j + 1
		}

		mut cat_keys := keys(categories)
		mut c := 0
		while c < len(cat_keys) {
			cat := cat_keys[c]
			mut cat_findings := categories[cat]

			# Category header
			mut cat_label := cat
			if cat == "cli-docs-alignment" { cat_label = "CLI ↔ Docs Alignment" }
			if cat == "spec-eval-alignment" { cat_label = "Spec ↔ Eval Alignment" }
			if cat == "manifest-docs-alignment" { cat_label = "Manifest ↔ Docs Alignment" }
			if cat == "version-consistency" { cat_label = "Version Consistency" }
			if cat == "example-validity" { cat_label = "Example Validity" }
			if cat == "source-of-truth" { cat_label = "Source of Truth" }

			report = report + "### " + cat_label + "\n\n"

			mut f := 0
			while f < len(cat_findings) {
				finding := cat_findings[f]
				sev_emoji := "🔵"
				if finding["severity"] == "critical" { sev_emoji = "🔴" }
				if finding["severity"] == "high" { sev_emoji = "🟠" }
				if finding["severity"] == "medium" { sev_emoji = "🟡" }
				if finding["severity"] == "low" { sev_emoji = "🔵" }

				report = report + "#### " + sev_emoji + " " + finding["title"] + "\n\n"
				report = report + "| Field | Value |\n"
				report = report + "|-------|-------|\n"
				report = report + "| **ID** | `" + finding["id"] + "` |\n"
				report = report + "| **Severity** | " + finding["severity"] + " |\n"
				report = report + "| **Confidence** | " + finding["confidence"] + " |\n"
				report = report + "| **Source** | `" + finding["source_artifact"] + "` |\n"
				report = report + "| **Target** | `" + finding["target_artifact"] + "` |\n"
				report = report + "| **Review Required** | " + to_string(finding["human_review_required"]) + " |\n\n"
				report = report + "**Summary:** " + finding["summary"] + "\n\n"
				report = report + "**Expected:** " + finding["expected"] + "\n\n"
				report = report + "**Actual:** " + finding["actual"] + "\n\n"
				report = report + "**Suggested Fix:** " + finding["suggested_fix"] + "\n\n"
				report = report + "---\n\n"
				f = f + 1
			}
			c = c + 1
		}
	}

	# Footer
	report = report + "---\n\n"
	report = report + "*Report generated by Concord v" + version + ". Concord is an MVP dogfood tool for the Kujo ecosystem.*\n"

	return report
}

export func generate_json_report(dir_path, findings) {
	version := concord_version()
	mut categorized := {}

	mut i := 0
	while i < len(findings) {
		f := findings[i]
		cat := f["category"]
		if has_key(categorized, cat) == 0 {
			categorized[cat] = []
		}
		mut cat_list := categorized[cat]
		cat_list = push(cat_list, f)
		categorized[cat] = cat_list
		i = i + 1
	}

	mut report := {
		"tool": "concord",
		"version": version,
		"directory": dir_path,
		"summary": {
			"total_findings": len(findings),
			"highest_severity": highest_severity(findings)
		},
		"findings": findings,
		"findings_by_category": categorized
	}

	return to_json_pretty(report)
}
