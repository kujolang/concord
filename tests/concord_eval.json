{
  "name": "concord-core",
  "version": "0.1.0",
  "description": "Repo-local eval metadata for Concord's own artifact-alignment contract.",
  "tests": [
    {
      "name": "scan markdown report",
      "check": "output_contains",
      "params": {
        "command": "cd /Users/robertdevore/2026/Kujolang/kujo-repos/co* && kujo run *.kujo -- scan",
        "expected": "# Concord Drift Report"
      }
    },
    {
      "name": "scan json includes findings key",
      "check": "output_contains",
      "params": {
        "command": "cd /Users/robertdevore/2026/Kujolang/kujo-repos/co* && kujo run *.kujo -- scan --format json",
        "expected": "\"findings\""
      }
    },
    {
      "name": "invalid args exit code",
      "check": "exit_code_equals",
      "params": {
        "command": "cd /Users/robertdevore/2026/Kujolang/kujo-repos/co* && kujo run *.kujo -- scan --bad-flag",
        "expected": 2
      }
    }
  ]
}
