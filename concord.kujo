# Concord — artifact drift and alignment checker for Kujo ecosystem projects.
#
# Usage:
#   ./kujo run concord.kujo scan [--dir <path>] [--format markdown|json]
#   ./kujo run concord.kujo check <category> [--dir <path>]
#   ./kujo run concord.kujo report [--dir <path>] [--format markdown|json]
#   ./kujo run concord.kujo tasks [--dir <path>]
#   ./kujo run concord.kujo version
#   ./kujo run concord.kujo help

VERSION := "1.0.0"

from src.common import parse_flag, parse_subcommand, shift_args, highest_severity, is_truthy, is_flag_token, verification_exit_code, scan_exit_code
from src.scanner import is_git_repo, is_kujo_project
from src.checks.cli_docs import check_cli_docs
from src.checks.spec_eval import check_spec_eval
from src.checks.manifest_docs import check_manifest_docs
from src.checks.version_consistency import check_version_consistency
from src.checks.example_validity import check_example_validity
from src.checks.source_of_truth import check_source_of_truth
from src.reporter import generate_markdown_report, generate_json_report
from src.fix_tasks import generate_fix_tasks

func print_lines(lines) {
	mut i := 0
	while i < len(lines) {
		print(lines[i])
		i = i + 1
	}
}

func append_findings(findings, new_findings) {
	mut result := findings
	mut i := 0
	while i < len(new_findings) {
		result = push(result, new_findings[i])
		i = i + 1
	}
	return result
}

func print_help() {
	print_lines([
		"Concord v" + VERSION,
		"",
		"An artifact drift and alignment checker for Kujo ecosystem projects.",
		"",
		"Usage:",
		"  ./kujo run concord.kujo scan [--dir <path>] [--format markdown|json]",
		"  ./kujo run concord.kujo check <category> [--dir <path>]",
		"  ./kujo run concord.kujo report [--dir <path>] [--format markdown|json]",
		"  ./kujo run concord.kujo tasks [--dir <path>]",
		"  ./kujo run concord.kujo version",
		"  ./kujo run concord.kujo help",
		"  ./kujo run concord.kujo --help",
		"  ./kujo run concord.kujo --version",
		"",
		"Commands:",
		"  scan     Run all drift checks and produce a full report",
		"  check    Run a specific check category",
		"  report   Generate report from the last scan",
		"  tasks    Generate fix task cards from scan findings",
		"  version  Print version information",
		"  help     Print this help message",
		"  --help   Print this help message",
		"  --version Print version information",
		"",
		"Check categories:",
		"  cli-docs       CLI ↔ Docs alignment",
		"  spec-eval      Spec ↔ Eval alignment",
		"  manifest       Manifest ↔ Docs alignment",
		"  versions       Version consistency",
		"  examples       Example validity",
		"  source-of-truth Source-of-truth mapping",
		"  all            All checks (same as scan)",
		"",
		"Options:",
		"  --dir <path>   Target directory (default: current directory)",
		"  --format       Output format: markdown (default) or json",
		"  --output <path> Write report to file instead of stdout",
		"",
		"Exit codes:",
		"  0  Success",
		"  2  Invalid usage or configuration",
		"  3  Verification/check failure (for check categories with findings)",
		"",
		"Examples:",
		"  ./kujo run concord.kujo scan",
		"  ./kujo run concord.kujo scan --dir /path/to/other-project --format json",
		"  ./kujo run concord.kujo check cli-docs",
		"  ./kujo run concord.kujo tasks --dir ../my-project",
	])
}

func print_version() {
	print_lines([
		"Concord v" + VERSION,
		"Artifact drift and alignment checker for Kujo ecosystem projects.",
		"Dogfood showcase tool — MVP.",
	])
}

func get_target_dir(argv) {
	dir_path := parse_flag(argv, "--dir", ".")
	return dir_path
}

func get_output_format(argv) {
	format := parse_flag(argv, "--format", "markdown")
	return format
}

func validate_args(subcommand, rest) {
	mut i := 0
	mut seen_category := 0
	while i < len(rest) {
		arg := rest[i]
		if arg == "--dir" || arg == "--format" || arg == "--output" {
			i = i + 1
			if i < len(rest) && is_flag_token(rest[i]) == 0 {
				i = i + 1
			}
			continue
		}
		if is_flag_token(arg) == 1 {
			print("Error: Unknown option '" + arg + "'")
			print("Run './kujo run concord.kujo help' for usage information.")
			return 0
		}
		if subcommand == "check" && seen_category == 0 {
			seen_category = 1
			i = i + 1
			continue
		}
		print("Error: Unexpected argument '" + arg + "'")
		print("Run './kujo run concord.kujo help' for usage information.")
		return 0
	}
	return 1
}

func run_all_checks(dir_path, kujo_bin) {
	mut findings := []

	findings = append_findings(findings, check_cli_docs(dir_path, kujo_bin))
	findings = append_findings(findings, check_spec_eval(dir_path))
	findings = append_findings(findings, check_manifest_docs(dir_path))
	findings = append_findings(findings, check_version_consistency(dir_path))
	findings = append_findings(findings, check_example_validity(dir_path, kujo_bin))
	findings = append_findings(findings, check_source_of_truth(dir_path))

	return findings
}

func run_check_category(category, dir_path, kujo_bin) {
	if category == "cli-docs" {
		return check_cli_docs(dir_path, kujo_bin)
	}
	if category == "spec-eval" {
		return check_spec_eval(dir_path)
	}
	if category == "manifest" {
		return check_manifest_docs(dir_path)
	}
	if category == "versions" {
		return check_version_consistency(dir_path)
	}
	if category == "examples" {
		return check_example_validity(dir_path, kujo_bin)
	}
	if category == "source-of-truth" {
		return check_source_of_truth(dir_path)
	}
	if category == "all" {
		return run_all_checks(dir_path, kujo_bin)
	}
	print("Error: Unknown check category '" + category + "'")
	print("Valid categories: cli-docs, spec-eval, manifest, versions, examples, source-of-truth, all")
	return []
}

func handle_scan(dir_path, kujo_bin, format, output_path) {
	mut findings := run_all_checks(dir_path, kujo_bin)

	mut report_output := ""
	if format == "json" {
		report_output = generate_json_report(dir_path, findings)
	} else {
		report_output = generate_markdown_report(dir_path, findings)
	}

	if output_path != "" {
		write_file(output_path, report_output)
		print("Report written to: " + output_path)
	} else {
		print(report_output)
	}

	# Exit code based on severity
	overall := highest_severity(findings)
	if overall == "high" {
		print("")
		print("⚠️  High-severity drift detected. Review findings above.")
	}
	if overall == "critical" {
		print("")
		print("⚠️  Critical drift detected. Review findings above.")
	}
	return scan_exit_code(findings)
}

func handle_check(dir_path, kujo_bin, format, rest) {
	if len(rest) < 1 {
		print("Error: 'check' requires a category argument.")
		print("Usage: ./kujo run concord.kujo check <category> [--dir <path>]")
		print("Categories: cli-docs, spec-eval, manifest, versions, examples, source-of-truth, all")
		return 2
	}
	category := rest[0]
	if category != "cli-docs" && category != "spec-eval" && category != "manifest" && category != "versions" && category != "examples" && category != "source-of-truth" && category != "all" {
		print("Error: Unknown check category '" + category + "'")
		print("Valid categories: cli-docs, spec-eval, manifest, versions, examples, source-of-truth, all")
		return 2
	}
	mut findings := run_check_category(category, dir_path, kujo_bin)

	if format == "json" {
		print(to_json_pretty(findings))
	} else {
		mut i := 0
		while i < len(findings) {
			f := findings[i]
			print("[" + f["severity"] + "] " + f["title"])
			print("  " + f["summary"])
			print("  Suggested: " + f["suggested_fix"])
			print("")
			i = i + 1
		}
		if len(findings) == 0 {
			print("No findings for category: " + category)
		}
	}
	return verification_exit_code(findings)
}

func handle_report(dir_path, kujo_bin, format, output_path) {
	mut findings := run_all_checks(dir_path, kujo_bin)

	mut report_output := ""
	if format == "json" {
		report_output = generate_json_report(dir_path, findings)
	} else {
		report_output = generate_markdown_report(dir_path, findings)
	}

	if output_path != "" {
		write_file(output_path, report_output)
		print("Report written to: " + output_path)
	} else {
		print(report_output)
	}
}

func handle_tasks(dir_path, kujo_bin, output_path) {
	mut findings := run_all_checks(dir_path, kujo_bin)
	mut tasks_output := generate_fix_tasks(findings)

	if output_path != "" {
		write_file(output_path, tasks_output)
		print("Fix tasks written to: " + output_path)
	} else {
		print(tasks_output)
	}
}

# --- Main ---

func main() {
	mut argv := args()

	if len(argv) == 0 {
		print_help()
		exit(0)
	}

	if argv[0] == "--help" || argv[0] == "-h" {
		print_help()
		exit(0)
	}

	if argv[0] == "--version" || argv[0] == "-v" {
		print_version()
		exit(0)
	}

	subcommand := parse_subcommand(argv)
	rest := shift_args(argv)

	dir_path := get_target_dir(rest)
	format := get_output_format(rest)
	output_path := parse_flag(rest, "--output", "")

	# Determine ./kujo binary
	mut kujo_bin := "kujo"

	if subcommand == "version" {
		if len(rest) > 0 {
			print("Error: Unexpected argument '" + rest[0] + "'")
			print("Run './kujo run concord.kujo help' for usage information.")
			exit(2)
		}
		print_version()
		exit(0)
	}

	if subcommand == "help" {
		if len(rest) > 0 {
			print("Error: Unexpected argument '" + rest[0] + "'")
			print("Run './kujo run concord.kujo help' for usage information.")
			exit(2)
		}
		print_help()
		exit(0)
	}

	if subcommand == "" && is_flag_token(argv[0]) == 1 {
		print("Error: Unknown option '" + argv[0] + "'")
		print("Run './kujo run concord.kujo help' for usage information.")
		exit(2)
	}

	# Validate directory
	if is_truthy(file_exists(dir_path)) == 0 {
		print("Error: Directory not found: " + dir_path)
		exit(2)
	}
	if is_truthy(path_is_dir(dir_path)) == 0 {
		print("Error: Not a directory: " + dir_path)
		exit(2)
	}

	if validate_args(subcommand, rest) == 0 {
		exit(2)
	}

	if subcommand == "scan" {
		exit(handle_scan(dir_path, kujo_bin, format, output_path))
	}

	if subcommand == "check" {
		exit(handle_check(dir_path, kujo_bin, format, rest))
	}

	if subcommand == "report" {
		handle_report(dir_path, kujo_bin, format, output_path)
		exit(0)
	}

	if subcommand == "tasks" {
		handle_tasks(dir_path, kujo_bin, output_path)
		exit(0)
	}

	# Unknown subcommand
	print("Error: Unknown command '" + subcommand + "'")
	print("Run './kujo run concord.kujo help' for usage information.")
	exit(2)
}

main()
